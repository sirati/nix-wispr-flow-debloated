+++ b/tools/mtmd/mtmd.cpp
@@ -5,6 +5,9 @@
 #include "mtmd-audio.h"
 #include "mtmd-image.h"
 #include "debug/mtmd-debug.h"
+#ifdef MTMD_COREML
