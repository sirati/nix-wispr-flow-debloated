+#endif
 
 #include "llama.h"
 #include "../src/llama-ext.h"
@@ -520,6 +523,10 @@ mtmd_context_params mtmd_context_params_default() {
 struct mtmd_context {
     struct clip_ctx * ctx_v; // vision
     struct clip_ctx * ctx_a; // audio
+#ifdef MTMD_COREML
+    // Granite Speech's audio encoder on Core ML, from $MTMD_COREML_AUDIO
+    struct mtmd_coreml * coreml = nullptr;
+#endif
     std::vector<float> out_embd; // image embedding vector
 
     // generation context
@@ -1071,6 +1078,12 @@ struct mtmd_context {
             case PROJECTOR_TYPE_GRANITE_SPEECH:
                 {
                     audio_preproc = std::make_unique<mtmd_audio_preprocessor_granite_speech>(ctx_a);
+#ifdef MTMD_COREML
+                    if (const char * path = getenv("MTMD_COREML_AUDIO"); path && *path) {
+                        coreml = mtmd_coreml_init(path);
+                        LOG_INF("%s: Core ML audio encoder %s: %s\n", __func__, path, coreml ? "loading" : "failed");
+                    }
+#endif
                 } break;
             case PROJECTOR_TYPE_GEMMA4A:
                 {
@@ -1148,6 +1161,9 @@ struct mtmd_context {
     }
 
     ~mtmd_context() {
+#ifdef MTMD_COREML
+        mtmd_coreml_free(coreml);
+#endif
         clip_free(ctx_a);
         clip_free(ctx_v);
         clip_free(ctx_gen_a);
@@ -2029,6 +2045,16 @@ static int32_t mtmd_encode_chunk_impl(mtmd_context * ctx, const mtmd_input_chunk
         }
         int n_mmproj_embd = ctx->n_embd_out();
         out_embd.resize((size_t)chunk->tokens_audio->n_tokens * n_mmproj_embd);
+#ifdef MTMD_COREML
+        if (ctx->coreml && chunk->tokens_audio->batch_f32.entries.size() == 1) {
+            const auto & mel = chunk->tokens_audio->batch_f32.entries[0];
+            if (mtmd_coreml_encode(ctx->coreml, mel.get_ro_buf().data(), mel.ny(), mel.nx(), out_embd.data(),
+                                   (int) chunk->tokens_audio->n_tokens, n_mmproj_embd)) {
+                return 0;
+            }
+            LOG_WRN("%s: Core ML audio encoder declined (%d frames), using ggml\n", __func__, mel.nx());
+        }
+#endif
         bool ok = clip_image_batch_encode(
             ctx->ctx_a,
             ctx->n_threads,
