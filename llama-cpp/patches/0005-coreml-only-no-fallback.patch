From: sirati <sirati@users.noreply.github.com>
Subject: [PATCH] mtmd: omit GGUF weights and duplicate model loads in Core ML mode

Core ML supplies Granite's complete audio encoder and projector. Retain only
GGUF format metadata and output dimensions; never load redundant GGUF weights
or initialize Core ML while estimating memory.

--- a/tools/mtmd/clip.cpp
+++ b/tools/mtmd/clip.cpp
@@ -169,6 +169,7 @@

     // for measuring memory usage
     bool no_alloc = false;
+    bool metadata_only = false;
     std::map<ggml_backend_dev_t, size_t> mem_usage;
     std::map<ggml_backend_dev_t, size_t> mem_compute;

@@ -4315,11 +4316,19 @@
     clip_ctx * ctx_gen_audio = nullptr;

     try {
+        bool coreml_only = false;
+#ifdef MTMD_COREML
+        const char * coreml_path = getenv("MTMD_COREML_AUDIO");
+        coreml_only = coreml_path && *coreml_path;
+#endif
         clip_model_loader loader(fname,
-            /* skip_tensors */ false,
+            /* skip_tensors */ coreml_only,
             ctx_params.progress_callback,
             ctx_params.progress_callback_user_data);
         bool skip_audio = false;
+        if (coreml_only && (!loader.has_audio || loader.has_vision || loader.has_gen_audio)) {
+            throw std::runtime_error("Core ML audio mode requires audio-only Granite Speech metadata");
+        }

         if (loader.has_vision) {
             ctx_vision = new clip_ctx(ctx_params);
@@ -4336,12 +4345,32 @@
         }

         if (loader.has_audio && !skip_audio) {
-            ctx_audio = new clip_ctx(ctx_params);
+            auto audio_params = ctx_params;
+            if (coreml_only) {
+                audio_params.use_gpu = false;  // preprocessing needs no Metal backend
+            }
+            ctx_audio = new clip_ctx(audio_params);
             loader.load_hparams(ctx_audio->model, CLIP_MODALITY_AUDIO);
-            loader.load_tensors(*ctx_audio);
-            loader.init_ctx(*ctx_audio);
-            if (ctx_params.warmup) {
-                loader.warmup(*ctx_audio);
+            if (coreml_only) {
+                if (ctx_audio->model.proj_type != PROJECTOR_TYPE_GRANITE_SPEECH) {
+                    throw std::runtime_error("Core ML audio mode requires Granite Speech metadata");
+                }
+                // Read the output dimension from the GGUF tensor descriptor,
+                // without allocating or reading any of its weight data.
+                const auto * projection = ggml_get_tensor(loader.ctx_meta.get(), "a.proj_linear.weight");
+                if (!projection || projection->ne[1] != 2048) {
+                    throw std::runtime_error("Core ML audio mode requires a 2048-dimensional Granite projector");
+                }
+                ctx_audio->metadata_only = true;
+                ctx_audio->model.hparams.projection_dim = (int) projection->ne[1];
+                ctx_audio->mem_usage[ggml_backend_get_device(ctx_audio->backend)] = 0;
+                fprintf(stderr, "mtmd_coreml: GGUF metadata only; no encoder/projector weight buffers loaded\n");
+            } else {
+                loader.load_tensors(*ctx_audio);
+                loader.init_ctx(*ctx_audio);
+                if (ctx_params.warmup) {
+                    loader.warmup(*ctx_audio);
+                }
             }
         }

@@ -6597,7 +6626,8 @@
         case PROJECTOR_TYPE_D1OMNI_A:
             return ctx->model.mm_3_w->ne[1];
         case PROJECTOR_TYPE_GRANITE_SPEECH:
-            return ctx->model.qf_proj_blocks[0].qf_proj_linear_w->ne[1];
+            return ctx->metadata_only ? ctx->model.hparams.projection_dim
+                                     : ctx->model.qf_proj_blocks[0].qf_proj_linear_w->ne[1];
         case PROJECTOR_TYPE_GRANITE4_VISION:
             return ctx->model.qf_proj_blocks.size() * ctx->model.hparams.projection_dim;
         case PROJECTOR_TYPE_GLM4V:
