+//! Commit dictated text through `wispr-ime`, an input method for the session.
+//!
+//! `wispr-ime` (org.wisprime.WisprIme on the session bus) puts text into the
+//! focused field the way typed text arrives, so the clipboard is left alone
+//! and no helper window takes focus. It answers `false` when no field it
+//! serves has focus; the caller then pastes as before. Set
+//! `WISPR_IME_COMMIT=0` to skip it.
+
+use std::sync::mpsc;
+use std::time::Duration;
+
+const BUS_NAME: &str = "org.wisprime.WisprIme";
+const PATH: &str = "/org/wisprime/WisprIme";
+const INTERFACE: &str = "org.wisprime.WisprIme1";
+/// Longer than a healthy call; short enough that a hung service does not
+/// stall dictation.
+const TIMEOUT: Duration = Duration::from_millis(1500);
+
+fn call(text: &str) -> zbus::Result<bool> {
+    let conn = zbus::blocking::Connection::session()?;
+    let reply = conn.call_method(Some(BUS_NAME), PATH, Some(INTERFACE), "Commit", &(text,))?;
+    Ok(reply.body().deserialize::<bool>()?)
+}
+
+/// True if `text` was committed and nothing more needs to be done.
+pub fn commit(text: &str) -> bool {
+    if std::env::var_os("WISPR_IME_COMMIT").is_some_and(|v| v == "0") || text.is_empty() {
+        return false;
+    }
+    let text = text.to_owned();
+    let (tx, rx) = mpsc::channel();
+    std::thread::spawn(move || {
+        let _ = tx.send(call(&text));
+    });
+    match rx.recv_timeout(TIMEOUT) {
+        Ok(Ok(true)) => {
+            log::info!("PasteText: committed through wispr-ime");
+            true
+        }
+        Ok(Ok(false)) => {
+            log::info!("PasteText: wispr-ime has no focused field; pasting");
+            false
+        }
+        Ok(Err(e)) => {
+            log::debug!("PasteText: wispr-ime unavailable ({e}); pasting");
+            false
+        }
+        Err(_) => {
+            log::warn!("PasteText: wispr-ime timed out; pasting");
+            false
+        }
+    }
+}
